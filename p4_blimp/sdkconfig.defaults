# Public, reproducible defaults for the Waveshare ESP32-P4-WiFi6 reference board.
# Keep real Wi-Fi credentials in the ignored sdkconfig generated by menuconfig.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_360=y

CONFIG_BLIMP_CAMERA_IMX219=y
# CONFIG_BLIMP_CAMERA_OV5647 is not set
CONFIG_BLIMP_CAMERA_XCLK_GPIO=20

CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_D0=14
CONFIG_ESP_HOSTED_SDIO_PIN_D1=15
CONFIG_ESP_HOSTED_SDIO_PIN_D2=16
CONFIG_ESP_HOSTED_SDIO_PIN_D3=17
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=54
CONFIG_ESP_HOSTED_SLAVE_RESET_ON_EVERY_HOST_BOOTUP=y
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y

CONFIG_ESP_WIFI_SSID="myssid"
CONFIG_ESP_WIFI_PASSWORD="mypassword"
CONFIG_BLIMP_COMMAND_PORT=5004
CONFIG_BLIMP_VIDEO_PORT=5005
CONFIG_BLIMP_LEFT_ESC_GPIO=29
CONFIG_BLIMP_RIGHT_ESC_GPIO=28
CONFIG_BLIMP_LEFT_TILT_GPIO=5
CONFIG_BLIMP_RIGHT_TILT_GPIO=4
CONFIG_BLIMP_LEFT_MOTOR_INVERTED=y
# CONFIG_BLIMP_RIGHT_MOTOR_INVERTED is not set
CONFIG_BLIMP_LEFT_ESC_NEUTRAL_US=1500
CONFIG_BLIMP_RIGHT_ESC_NEUTRAL_US=1500
CONFIG_BLIMP_LEFT_MOTOR_FORWARD_SCALE_PERCENT=100
CONFIG_BLIMP_LEFT_MOTOR_REVERSE_SCALE_PERCENT=100
CONFIG_BLIMP_RIGHT_MOTOR_FORWARD_SCALE_PERCENT=100
CONFIG_BLIMP_RIGHT_MOTOR_REVERSE_SCALE_PERCENT=100
CONFIG_BLIMP_LEFT_SERVO_INVERTED=y
# CONFIG_BLIMP_RIGHT_SERVO_INVERTED is not set
CONFIG_BLIMP_LEFT_SERVO_NEUTRAL_ANGLE=90
CONFIG_BLIMP_RIGHT_SERVO_NEUTRAL_ANGLE=90
CONFIG_BLIMP_IMU_SCL_GPIO=8
CONFIG_BLIMP_IMU_SDA_GPIO=7
CONFIG_BLIMP_IMU_POWER_GPIO=-1
CONFIG_BLIMP_IMU_ZERO_AT_STARTUP=y
# CONFIG_BLIMP_IMU_AXES_NATIVE is not set
CONFIG_BLIMP_IMU_AXES_SWAPPED=y
# CONFIG_BLIMP_IMU_INVERT_ROLL is not set
# CONFIG_BLIMP_IMU_INVERT_PITCH is not set
